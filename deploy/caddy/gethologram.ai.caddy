# The gethologram.ai site block in the VPS's front Caddyfile (/root/twenty/Caddyfile), exactly as it runs. Every path
# the apex answers comes from this repository: the edge (deploy/edge/), the Spaces and their object store
# (deploy/spaces/), and everything else from this repository's site on Pages. Applied 2026-11-16, replacing the
# routes to Hologram-Technologies/hologram-live, whose services were stopped, not deleted (docs/cutover.md).
#
# Rollback: restore the Caddyfile backup the apply wrote, `caddy reload`, and start hologram-live's services.

gethologram.ai, hub.uor.foundation {
	# Every path is answered by Hologram-Technologies/hub (deploy/caddy/gethologram.ai.caddy). hologram-live's
	# services are stopped, not deleted: restoring the previous Caddyfile and starting them is the rollback.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The Hugging Face dialect under /via/<source>/, all but SHA256SUMS. The published source names are translated to
	# the kernel's here rather than added to the proved model.
	@via_edge {
		path_regexp via_edge ^/via/(huggingface|modelscope|ipfs|huggingface\.co|modelscope\.cn)/([^/]+/[^/]+/resolve/|api/)
		not path */SHA256SUMS
	}
	handle @via_edge {
		request_header -Authorization
		request_header -Cookie
		uri path_regexp ^/via/huggingface/ /via/huggingface.co/
		uri path_regexp ^/via/modelscope/ /via/modelscope.cn/
		reverse_proxy hub-edge:8787
	}

	# The Hugging Face dialect, for models, datasets and Spaces: every /api/ path, every file route and the access
	# reports. The edge reads which operation a request is from the kernel's surface table and refuses what the
	# kernel refuses (HK-31, HK-32), so nothing here decides. Clients send their Hugging Face token to whatever
	# HF_ENDPOINT names; it never reaches the edge. The object store's addresses stay with the Spaces server.
	@edge {
		path_regexp edge ^(/api/|/(datasets/|spaces/)?([^/]+/)?[^/]+/resolve/|/(datasets/)?[^/]+/[^/]+/user-access-report$)
		not path /via/*
		not path /api/v1/objects/sha256:*
	}
	handle @edge {
		request_header -Authorization
		request_header -Cookie
		reverse_proxy hub-edge:8787
	}

	# The Spaces (HK-27), from deploy/spaces/ on this server rather than Pages: their runtime is past the Pages budget.
	@spaceapp {
		path_regexp spaceapp ^/spaces/[^/]+/
	}
	handle @spaceapp {
		reverse_proxy hub-spaces:8080
	}
	@spacekit path /kit/hologram-warm.css /kit/hologram-gap-tokens.css /spaces/spaces.json
	handle @spacekit {
		reverse_proxy hub-spaces:8080
	}
	# A Space sealed to load /tokens.css gets the file it was sealed with, which is not the hub site's /tokens.css.
	@spacetokens {
		path /tokens.css
		header_regexp spacetokens Referer ^https?://[^/]+/spaces/[^/]+/
	}
	handle @spacetokens {
		rewrite * /spaces-compat/tokens.css
		reverse_proxy hub-spaces:8080
	}

	# The object store (HK-28): every published Space file under the SHA-256 of its bytes.
	@object {
		method GET HEAD
		path_regexp object ^/api/v1/objects/sha256:([0-9a-f]{64})$
	}
	handle @object {
		rewrite * /objects/sha256/{re.object.1}
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy hub-spaces:8080
	}

	# A browser following a Hugging Face link to a model page, /<owner>/<name>, gets this site's page for it.
	@hfpage {
		header Accept *text/html*
		path_regexp hfpage ^/([^/]+)/([^/]+?)/?$
		not path /app/* /data/* /fonts/* /logos/* /wallpapers/* /models/* /spaces/* /docs/* /buckets/* /kit/* /api/* /via/*
	}
	redir @hfpage /models/{re.hfpage.1}/{re.hfpage.2}/ 302

	# A tool asking for the apex's bare name, `curl gethologram.ai`, gets the plain-text guide (HK-33): a static file
	# Pages publishes, written from the home screen's model, so answering it costs no server. A browser gets the site.
	# The answer depends on the client, so a cache must key on it.
	@tool {
		path /
		header_regexp tool User-Agent ^(curl|Wget|HTTPie|xh)/
	}
	header / Vary User-Agent
	handle @tool {
		rewrite * /hub/agent.txt
		reverse_proxy https://hologram-technologies.github.io {
			header_up Host hologram-technologies.github.io
		}
	}

	# Everything else is this repository's site, as Pages publishes it. Pages answers a directory without its slash
	# with an absolute redirect to its own host; that Location is made relative so a reader stays on the apex.
	handle {
		rewrite * /hub{uri}
		reverse_proxy https://hologram-technologies.github.io {
			header_up Host hologram-technologies.github.io
			header_down Location ^https://hologram-technologies\.github\.io/hub/ /
		}
	}
}

# Plain http. A tool's bare request gets the same guide, since curl does not follow a redirect unless told to and an
# empty 308 is all it would print; everything else moves to https, as Caddy's automatic redirect did before this block
# replaced it.
http://gethologram.ai, http://hub.uor.foundation {
	@tool {
		path /
		header_regexp tool User-Agent ^(curl|Wget|HTTPie|xh)/
	}
	header / Vary User-Agent
	handle @tool {
		rewrite * /hub/agent.txt
		reverse_proxy https://hologram-technologies.github.io {
			header_up Host hologram-technologies.github.io
		}
	}
	handle {
		redir https://{host}{uri} 308
	}
}
